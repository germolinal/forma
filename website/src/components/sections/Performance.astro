---
import { links } from "../../config/site";
import PerformanceChart from "./PerformanceChart.astro";
// Written by `make bench-site` (or `make bench-chart`) in forma/: the summary
// of two runs of `make bench`, without and with OpenTelemetry.
import bench from "../../data/bench.json";

const plain = bench.runs["Without OpenTelemetry"];
const otel = bench.runs["With OpenTelemetry"];

const ms = (v: number) => `${v < 10 ? v.toFixed(1) : Math.round(v)} ms`;
const mb = (v: number) => `${Math.round(v)} MB`;
const perS = (v: number) => `${Math.round(v).toLocaleString("en-US")}/s`;
const range = (r: typeof plain) =>
  `${Math.round(r.targets.none.rss_mb_one_conversation)}–${mb(r.targets.mongo.rss_mb_peak)}`;
const realistic = plain.targets.mongo.realistic;

const stats = [
  {
    label: "Forma's own time per message",
    value: ms(plain.targets.none.overhead_ms),
    detail: `On top of the LLM, median. ${ms(plain.targets.mongo.overhead_ms)} with MongoDB, including its round trips.`,
    otel: ms(otel.targets.none.overhead_ms),
  },
  {
    label: "Memory",
    value: range(plain),
    detail: `From one conversation to ${realistic.concurrency} at once, with MongoDB.`,
    otel: range(otel),
  },
  {
    label: "CPU per message",
    value: ms(plain.targets.mongo.cpu_ms_per_message),
    detail: `The whole tool loop, streamed: ${realistic.concurrency} conversations at once keep ${realistic.cores_busy.toFixed(2)} of a core busy.`,
    otel: ms(otel.targets.mongo.cpu_ms_per_message),
  },
  {
    label: "Messages per second, at most",
    value: perS(plain.targets.none.messages_per_s),
    detail: `Forma's ceiling, with an LLM that answers instantly. With a real LLM's pace, ${realistic.concurrency} conversations at once make ${Math.round(realistic.messages_per_s)} messages/s: the LLM sets the pace.`,
    otel: perS(otel.targets.none.messages_per_s),
  },
];
---

<section class="shell section border-t">
  <h2 class="text-3xl font-semibold sm:text-4xl">
    Light enough for the smallest machine
  </h2>
  <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-relaxed">
    An LLM takes seconds to answer; Forma adds milliseconds. A personal agent
    runs comfortably on the smallest machine a cloud sells, and the same server
    handles many conversations at once.
  </p>

  <dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="bg-card text-card-foreground flex flex-col rounded-xl border p-6">
          <dt class="text-muted-foreground order-2 mt-1 text-sm font-medium">
            {stat.label}
          </dt>
          <dd class="font-display order-1 text-3xl font-semibold tabular-nums">
            {stat.otel}
          </dd>
        </div>
      ))
    }
  </dl>

  <PerformanceChart />

  <p class="text-muted-foreground mt-6 max-w-3xl text-sm leading-relaxed">
    Measured with <code class="font-mono">make bench</code> ({
      plain.machine.replace(/\.$/, "")
    }). Each message is a full tool loop: an LLM call that asks for a tool, the
    tool, and an LLM call that answers. The LLM is a mock, so the numbers are
    Forma's alone; MongoDB ran on the same machine, indexed, holding 50,000
    other messages. "With OpenTelemetry" exports traces, metrics and logs to a
    collector, which costs memory and CPU, more so under heavy load. A cloud's
    shared CPU answers fewer messages per second, but memory and CPU per message
    carry over.
    <a
      href={links.bench}
      class="text-accent-text underline-offset-4 hover:underline"
      >Run it yourself</a
    >.
  </p>
</section>
