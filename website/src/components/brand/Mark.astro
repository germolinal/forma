---
/**
 * The square mark: an "F" whose middle arm ends in an amber node, one
 * definition branching out to its channels. Same artwork as public/mark.svg.
 */
interface Props {
  class?: string;
}

const { class: className = "size-8" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  class={className}
  aria-hidden="true"
>
  <rect width="64" height="64" rx="15" fill="#141922"></rect>
  <rect x="17" y="13" width="9" height="38" rx="4.5" fill="#F4F1EA"></rect>
  <rect x="17" y="13" width="31" height="9" rx="4.5" fill="#F4F1EA"></rect>
  <rect x="17" y="28.5" width="19" height="9" rx="4.5" fill="#F4F1EA"></rect>
  <circle cx="44.5" cy="33" r="4.5" fill="#F2A93B"></circle>
</svg>
