# Runtime base, pinned by digest so every build of this file runs on the same
# bytes. Bump it on purpose. The LABEL below records it in the image, so the
# base of any published image can be traced back.
ARG BASE_IMAGE=gcr.io/distroless/cc-debian12:latest@sha256:e5d81ddde149641e2a9ba55be4545bc125c67de07508b03ba4c22e6eb0ded5aa

FROM rust:1.99.1-bookworm as build

WORKDIR /app

RUN apt-get -o Acquire::Check-Valid-Until=false update && apt-get upgrade -y

COPY . .

# Empty for a single-tenant server, or `multi-tenant`. How clients talk to the
# agent, and where conversations are kept, are in the runtime.yaml it is given.
ARG FEATURES=""
RUN cargo build --release --bin forma --no-default-features --features "${FEATURES}"

# Move into distroless
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

ARG PORT=8080
EXPOSE ${PORT}

COPY --from=build /app/target/release/forma /app/forma
# The runtime file is not in the image: whoever runs it mounts one at
# /config/runtime.yaml (e.g., `docker run -v ./runtime.yaml:/config/runtime.yaml`,
# or a secret mounted as a file on Cloud Run), or replaces this command. Exec
# form does no variable expansion, so --service is left off deliberately: it is
# resolved at runtime from Cloud Run's K_SERVICE env var instead.
CMD ["/app/forma", "serve", "-t", "just-otel", "-r", "/config/runtime.yaml"]
